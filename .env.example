# Copy this file to ".env" and fill in your real keys.
# Or just export them in your shell before running.

# Which vendor runs the agents: anthropic (default) or openai. See config.py.
LLM_PROVIDER=anthropic

# Which vendor judges the evals; defaults to LLM_PROVIDER. A judge from another
# vendor avoids a model grading its own answers.
# JUDGE_PROVIDER=openai

# Needed when a provider is anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Needed when a provider is openai (GPT-4o), and always by
# evals/test_agent_synthesized.py (DeepEval's synthesizer embeds with OpenAI)
OPENAI_API_KEY=sk-your-key-here

# Used by rag_agent.py for embeddings (Voyage AI, key from MongoDB Atlas)
VOYAGE_API_KEY=your-voyage-key-here
