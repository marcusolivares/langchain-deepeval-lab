# Copy this file to ".env" and fill in your real keys.
# Or just export them in your shell before running.

# Used by the agent itself (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Used by the DeepEval judge LLM (GPT-4o)
OPENAI_API_KEY=sk-your-key-here

# Used by rag_agent.py for embeddings (Voyage AI, key from MongoDB Atlas)
VOYAGE_API_KEY=your-voyage-key-here
