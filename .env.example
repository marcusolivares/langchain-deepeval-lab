# Copy this file to ".env" and fill in your real keys.
# Or just export them in your shell before running.

# Which vendor runs the agents: anthropic (default) or openai. See config.py.
LLM_PROVIDER=anthropic

# Needed when a provider is anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Needed when a provider is openai (GPT-4o)
OPENAI_API_KEY=sk-your-key-here

# Used by rag_agent.py for embeddings (Voyage AI, key from MongoDB Atlas)
VOYAGE_API_KEY=your-voyage-key-here
